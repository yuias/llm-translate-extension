{
  "name": "llm-translate-extension",
  "description": "Translate selected text or whole pages with an OpenAI-compatible LLM",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@10.32.1"
}
